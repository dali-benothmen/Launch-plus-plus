{
  "name": "launchplusplus",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source project manager built around a first-class plugin platform.",
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.6.1 <11"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-runtime.mjs",
    "check": "pnpm runtime:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:arch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "runtime:check": "node ./scripts/check-runtime.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test --pass-with-no-tests",
    "test:arch": "node ./scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
