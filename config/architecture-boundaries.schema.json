{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpp.dev/schemas/internal/architecture-boundaries.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaceRoots", "packageNamePattern", "packages", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "workspaceRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "packageNamePattern": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "owner", "visibility", "allowWorkspaceDependencies"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "visibility": { "enum": ["internal", "public"] },
          "allowWorkspaceDependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "deny"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "deny": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
