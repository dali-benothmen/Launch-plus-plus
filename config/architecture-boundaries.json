{
  "$schema": "./architecture-boundaries.schema.json",
  "workspaceRoots": ["apps", "packages"],
  "packageNamePattern": "^@launchpp(?:-internal)?/[a-z0-9-]+$",
  "packages": [
    {
      "name": "@launchpp-internal/web",
      "path": "apps/web",
      "owner": "web",
      "visibility": "internal",
      "allowWorkspaceDependencies": [
        "@launchpp/api-client",
        "@launchpp/plugin-protocol",
        "@launchpp/theme-runtime",
        "@launchpp/ui",
        "@launchpp/ui-tokens"
      ]
    },
    {
      "name": "@launchpp-internal/server",
      "path": "apps/server",
      "owner": "server",
      "visibility": "internal",
      "allowWorkspaceDependencies": [
        "@launchpp/api-contracts",
        "@launchpp/auth-adapter",
        "@launchpp/authorization",
        "@launchpp/core",
        "@launchpp/database",
        "@launchpp/plugin-protocol",
        "@launchpp/plugin-runtime"
      ]
    },
    {
      "name": "@launchpp/core",
      "path": "packages/core",
      "owner": "core",
      "visibility": "internal",
      "allowWorkspaceDependencies": []
    },
    {
      "name": "@launchpp/database",
      "path": "packages/database",
      "owner": "persistence",
      "visibility": "internal",
      "allowWorkspaceDependencies": ["@launchpp/core"]
    },
    {
      "name": "@launchpp/api-contracts",
      "path": "packages/api-contracts",
      "owner": "api",
      "visibility": "internal",
      "allowWorkspaceDependencies": []
    },
    {
      "name": "@launchpp/api-client",
      "path": "packages/api-client",
      "owner": "api",
      "visibility": "internal",
      "allowWorkspaceDependencies": ["@launchpp/api-contracts"]
    },
    {
      "name": "@launchpp/authorization",
      "path": "packages/authorization",
      "owner": "core",
      "visibility": "internal",
      "allowWorkspaceDependencies": ["@launchpp/core"]
    },
    {
      "name": "@launchpp/auth-adapter",
      "path": "packages/auth-adapter",
      "owner": "identity",
      "visibility": "internal",
      "allowWorkspaceDependencies": ["@launchpp/core", "@launchpp/database"]
    },
    {
      "name": "@launchpp/ui",
      "path": "packages/ui",
      "owner": "design-system",
      "visibility": "public",
      "allowWorkspaceDependencies": ["@launchpp/theme-runtime", "@launchpp/ui-tokens"]
    },
    {
      "name": "@launchpp/ui-tokens",
      "path": "packages/ui-tokens",
      "owner": "design-system",
      "visibility": "public",
      "allowWorkspaceDependencies": ["@launchpp/theme-schema"]
    },
    {
      "name": "@launchpp/theme-schema",
      "path": "packages/theme-schema",
      "owner": "design-system",
      "visibility": "public",
      "allowWorkspaceDependencies": []
    },
    {
      "name": "@launchpp/theme-runtime",
      "path": "packages/theme-runtime",
      "owner": "design-system",
      "visibility": "public",
      "allowWorkspaceDependencies": ["@launchpp/theme-schema"]
    },
    {
      "name": "@launchpp/plugin-protocol",
      "path": "packages/plugin-protocol",
      "owner": "plugin-platform",
      "visibility": "public",
      "allowWorkspaceDependencies": []
    },
    {
      "name": "@launchpp/plugin-runtime",
      "path": "packages/plugin-runtime",
      "owner": "plugin-platform",
      "visibility": "internal",
      "allowWorkspaceDependencies": ["@launchpp/plugin-protocol"]
    },
    {
      "name": "@launchpp/plugin-testkit",
      "path": "packages/plugin-testkit",
      "owner": "plugin-platform",
      "visibility": "internal",
      "allowWorkspaceDependencies": ["@launchpp/plugin-protocol", "@launchpp/plugin-runtime"]
    }
  ],
  "rules": [
    {
      "from": "@launchpp/core",
      "deny": [
        "@launchpp/database",
        "@launchpp/auth-adapter",
        "@launchpp/plugin-platform",
        "@launchpp/plugin-runtime",
        "@launchpp/plugin-sdk",
        "@launchpp/ui",
        "fastify",
        "react",
        "drizzle-orm"
      ]
    },
    {
      "from": "@launchpp/plugin-protocol",
      "deny": [
        "@launchpp/core",
        "@launchpp/database",
        "@launchpp/plugin-platform",
        "@launchpp/ui",
        "fastify",
        "react",
        "drizzle-orm"
      ]
    },
    {
      "from": "@launchpp/plugin-data",
      "deny": ["@launchpp/database", "better-sqlite3", "drizzle-orm"]
    },
    {
      "from": "@launchpp/plugin-sdk",
      "deny": [
        "@launchpp/core",
        "@launchpp/database",
        "@launchpp/plugin-platform",
        "@launchpp/plugin-runtime"
      ]
    },
    {
      "from": "@launchpp/ui",
      "deny": [
        "@launchpp/core",
        "@launchpp/database",
        "@launchpp/plugin-platform",
        "@launchpp/plugin-runtime"
      ]
    },
    {
      "from": "@launchpp/ui-tokens",
      "deny": [
        "@launchpp/core",
        "@launchpp/database",
        "@launchpp/plugin-platform",
        "@launchpp/plugin-runtime",
        "react"
      ]
    },
    {
      "from": "@launchpp/theme-schema",
      "deny": ["@launchpp/core", "@launchpp/database", "fastify", "react", "drizzle-orm"]
    },
    {
      "from": "@launchpp/theme-runtime",
      "deny": ["@launchpp/core", "@launchpp/database", "fastify", "react", "drizzle-orm"]
    },
    {
      "from": "@launchpp-internal/web",
      "deny": ["@launchpp/database", "@launchpp/auth-adapter", "@launchpp/plugin-runtime"]
    }
  ]
}
